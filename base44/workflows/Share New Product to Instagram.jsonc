{
  "name": "Share New Product to Instagram",
  "description": "Auto-publishes new shop products to The Fitness Galaxy Instagram Business account",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Product",
      "events": [
        "create"
      ]
    },
    "condition": "${ (.trigger.data.image_url // \"\") != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "share_product_to_instagram",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_to_instagram": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postToInstagram",
            "args": {
              "entity_type": "product",
              "title": "${ .trigger.data.name }",
              "description": "${ .trigger.data.description }",
              "image_url": "${ .trigger.data.image_url }",
              "product_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to Instagram",
            "description": "Share the new shop product"
          }
        }
      }
    ]
  }
}